# Local development ONLY (Phase 05). Copy to .env.local:  cp .env.local.example .env.local
# Every value below is a fake, local-only placeholder. Nothing here points at production.
# Never put a real secret in this file (it is committed).

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Nusantara Play (local)
FRONTEND_URLS=http://localhost:3001
# Rate limit: requests come straight from localhost, so the default is fine (see .env.example).
TRUST_PROXY=loopback

# Database: the Docker container from docker-compose.dev.yml (npm run db:up).
# "localdev" is a fixed, publicly known, local-only password. Never use it anywhere else.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=localdev
DATABASE_NAME=nusantara_play_dev
DATABASE_SSL=false

# Supabase: fake placeholders. The .invalid TLD never resolves, so nothing is ever contacted.
# Login does NOT work locally until the self-hosted auth phase.
SUPABASE_URL=https://supabase-placeholder.invalid
SUPABASE_ANON_KEY=local-placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=local-placeholder-service-role-key
SUPABASE_JWT_SECRET=local-placeholder-jwt-secret

# AWS S3: fake placeholders (required for the app to boot; uploads will fail locally).
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=LOCALPLACEHOLDERKEYID
AWS_SECRET_ACCESS_KEY=local-placeholder-secret-access-key
AWS_S3_BUCKET=local-placeholder-bucket

# Email: disabled; fake host.
USER_CREDENTIAL_EMAIL_ENABLED=false
SMTP_HOST=smtp.placeholder.invalid
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=local-placeholder
SMTP_PASS=local-placeholder
SMTP_FROM="Nusantara Play (local) <no-reply@example.test>"

# Blockchain: intentionally EMPTY. With empty values BlockchainService logs a warning
# and stays inactive. Do not put a real key here.
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK=polygon-amoy
