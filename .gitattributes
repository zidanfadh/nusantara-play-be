# Normalize all text files to LF in the repository and in the working tree.
* text=auto eol=lf

# Binary files: never touch line endings, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.glb   binary
*.zip   binary
