# Application
NODE_ENV=development
PORT=3000
APP_NAME=Nusantara Play

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=nusantara_play

# Supabase Auth
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-super-secret-jwt-key

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=nusantara-play-storage

# CORS
# Use comma-separated values for multiple frontend origins.
FRONTEND_URLS=http://localhost:3001,https://nusantaralegacy.org,https://nusantaravirtual.org
# Legacy single-origin fallback if FRONTEND_URLS is unset:
# FRONTEND_URL=http://localhost:3001

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Blockchain (Polygon Mumbai)
# Get a free RPC endpoint from https://alchemy.com or https://infura.io
BLOCKCHAIN_RPC_URL=https://rpc-mumbai.polygon.technology
# Your wallet private key (never commit the real key — use .env only)
BLOCKCHAIN_PRIVATE_KEY=0x_your_wallet_private_key_here
# Contract address obtained after running: cd backend/blockchain && npm run deploy:mumbai
BLOCKCHAIN_CONTRACT_ADDRESS=0x_contract_address_after_deploy
# Network identifier stored in blockchain_proof.blockchain_network column
BLOCKCHAIN_NETWORK=polygon-mumbai
