# Copy to .env.local (or .env) and fill in. Never commit real values.
# The app and the migration CLI both load .env.local first, then .env.

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Nusantara Play
# Express "trust proxy": which proxies may set X-Forwarded-For (req.ip drives the per-IP rate
# limit for anonymous requests; logged-in users are limited per user id). Default "loopback" =
# the app runs directly on the host behind a host nginx. If the app runs in Docker with the port
# published on 127.0.0.1 (docker-compose.prod.yml), connections arrive from the Docker bridge
# gateway (172.x), so use "loopback, uniquelocal". Also accepted: a hop count ("1"),
# "true"/"false", addresses and subnets. Never "true": anyone could then fake their IP.
TRUST_PROXY=loopback

# Database (PostgreSQL) — used by the app AND by npm run migration:*
# Option 1: a full connection URL. If set, it wins over the individual params below.
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/nusantara_play
# Option 2: individual params (used only when DATABASE_URL is empty).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=nusantara_play
# 'true' enables SSL (rejectUnauthorized=false), e.g. for hosted Postgres. Keep false locally.
DATABASE_SSL=false
# The old DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD/DB_DATABASE/DB_SSL names are deprecated
# (migration CLI still reads them as a fallback and prints a warning).

# Supabase Auth
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-super-secret-jwt-key

# Self-hosted auth (Phase 07). Local auth (our RS256 access tokens + JWKS) is ENABLED only when
# JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, JWT_KEY_ID, JWT_ISSUER and JWT_AUDIENCE are all set; otherwise
# the app still starts, logs one warning and accepts only legacy Supabase tokens.
# Generate keys with: npm run auth:generate-keys  (prints the lines; writes nothing to disk).
# Generate production keys ON the server; never reuse dev keys. JWT_PRIVATE_KEY is a secret.
# Keys are PEM files base64-encoded on one line (PKCS#8 private key, SPKI public key, RSA >= 2048).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Key id: sent as the "kid" header and in the JWKS (GET /api/auth/jwks.json).
JWT_KEY_ID=
# Token issuer (iss) and audience (aud); verified on every request.
JWT_ISSUER=https://api.nusantaralegacy.org
JWT_AUDIENCE=nusantara-play
# Access token lifetime in seconds (default 900 = 15 minutes).
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days (default 30); rotated on every use.
REFRESH_TOKEN_TTL_DAYS=30
# Reusing a just-rotated refresh token within this many seconds returns refresh_conflict
# (two tabs refreshing at once) instead of revoking the whole token family (default 20).
REFRESH_REUSE_GRACE_SECONDS=20
# Keep accepting Supabase tokens through the legacy strategy (default true). Set false only after
# every user has moved to the self-hosted login.
AUTH_ACCEPT_SUPABASE_TOKENS=true
# Phase 08: login cookies. Path of the httpOnly np_refresh cookie = the path the BROWSER uses for the
# auth endpoints: /backend-api/auth in production (Vercel rewrite), /api/auth in local development.
AUTH_COOKIE_PATH=/backend-api/auth
# Secure flag of both auth cookies. Empty = true when NODE_ENV=production, false otherwise.
AUTH_COOKIE_SECURE=
# CSRF check of /auth/refresh, /auth/logout, /auth/logout-all (and /auth/change-password when it reads
# the cookie): Origin must be in FRONTEND_URLS or FULLY match one of these comma-separated regular
# expressions (meant for Vercel preview domains). Empty by default.
FRONTEND_ORIGIN_PATTERNS=
# Account lockout: after LOGIN_MAX_FAILED wrong passwords in a row the account is locked for
# LOGIN_LOCK_MINUTES (defaults 5 and 15).
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
# Phase 09: email verification and password reset. Base URL of the FRONTEND for links in emails
# ({APP_PUBLIC_URL}/verify-email?token=..., {APP_PUBLIC_URL}/reset-password?token=...).
# Production: https://nusantaralegacy.org. Without it, verification and reset emails are not sent.
APP_PUBLIC_URL=https://nusantaralegacy.org
# Link lifetimes (defaults 24 hours and 60 minutes).
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=nusantara-play-storage

# CORS
# Use comma-separated values for multiple frontend origins.
FRONTEND_URLS=http://localhost:3001,https://nusantaralegacy.org,https://www.nusantaralegacy.org,https://nusantaravirtual.org
# Legacy single-origin fallback if FRONTEND_URLS is unset:
# FRONTEND_URL=http://localhost:3001

# Email (SMTP) — login credentials of admin-created users, and (Phase 09) the email verification,
# password reset, "account already exists" and "password changed" emails (those need only SMTP_HOST
# and SMTP_FROM; local development uses Mailpit, see .env.local.example).
# Set to 'true' to send credential emails (also needs SMTP_HOST and SMTP_FROM).
USER_CREDENTIAL_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
# Defaults to 587 if empty.
SMTP_PORT=587
# 'true' for implicit TLS (usually port 465); 'false' for STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Sender address; falls back to SMTP_USER if empty.
SMTP_FROM="Nusantara Play <no-reply@example.com>"

# Rewards (Phase 15): days newly granted Points stay on hold before they become
# redeemable (integer 0..365; anything else = 7). No rule grants Points yet.
POINTS_HOLD_DAYS=7

# Blockchain (Polygon Amoy testnet) — deprioritized
# Public Amoy RPC; a dedicated endpoint from a provider such as Alchemy or Infura also works.
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# Your wallet private key (never commit the real key — use .env only)
BLOCKCHAIN_PRIVATE_KEY=0x_your_wallet_private_key_here
# Contract address obtained after deploying the contract in blockchain/
BLOCKCHAIN_CONTRACT_ADDRESS=0x_contract_address_after_deploy
# Network identifier stored in blockchain_proof.blockchain_network column
BLOCKCHAIN_NETWORK=polygon-amoy
