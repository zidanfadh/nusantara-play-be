{
  "info": {
    "name": "Nusantara Play - PROT API",
    "description": "API Collection for PROT (Permainan Rakyat dan Olahraga Tradisional) Module with Verification System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "disabled": true
    },
    {
      "key": "protId",
      "value": "",
      "type": "string",
      "disabled": true
    },
    {
      "key": "queueId",
      "value": "",
      "type": "string",
      "disabled": true
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "PROT - Public",
      "item": [
        {
          "name": "List All PROT",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prot?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["prot"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                },
                {
                  "key": "jenis",
                  "value": "PERMAINAN_RAKYAT",
                  "description": "Filter by jenis",
                  "disabled": true
                },
                {
                  "key": "provinsi",
                  "value": "11",
                  "description": "Filter by provinsi kode",
                  "disabled": true
                },
                {
                  "key": "kabkota",
                  "value": "11.01",
                  "description": "Filter by kabkota kode",
                  "disabled": true
                },
                {
                  "key": "targetUsia",
                  "value": "ANAK",
                  "description": "Filter by target usia",
                  "disabled": true
                },
                {
                  "key": "search",
                  "value": "gasing",
                  "description": "Search by nama",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "ARSIP_NASIONAL",
                  "description": "Filter by status (DRAFT, DIKURASI, REVISI, DIVERIFIKASI, ARSIP_NASIONAL)",
                  "disabled": true
                },
                {
                  "key": "created_by",
                  "value": "",
                  "description": "Filter by creator UUID",
                  "disabled": true
                }
              ]
            },
            "description": "Get all PROT with pagination and optional filters. Public endpoint - no authentication required. Role-based filtering applies."
          },
          "response": []
        },
        {
          "name": "Get PROT by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prot/:id",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Get a specific PROT by ID. Public endpoint - no authentication required."
          },
          "response": []
        }
      ],
      "description": "Public endpoints - no authentication required"
    },
    {
      "name": "PROT - Kurator Daerah",
      "item": [
        {
          "name": "Create PROT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Gasing\",\n  \"jenis\": \"PERMAINAN_RAKYAT\",\n  \"statusAsalUsul\": \"Permainan tradisional yang sudah ada sejak zaman kerajaan di Indonesia\",\n  \"provinsiKode\": \"11\",\n  \"kabkotaKode\": \"11.01\",\n  \"targetUsia\": \"ANAK\",\n  \"caraBermain\": \"Gasing diputar menggunakan tali yang dililitkan pada bagian badan gasing\",\n  \"nilaiMoral\": \"Melatih kesabaran, ketelitian, dan motorik halus anak\",\n  \"peralatan\": [\n    {\n      \"nama\": \"Gasing\",\n      \"deskripsi\": \"Gasing kayu dengan paku di bagian bawah\",\n      \"kisaranHarga\": \"10.000 - 50.000\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/prot",
              "host": ["{{base_url}}"],
              "path": ["prot"]
            },
            "description": "Create a new PROT with DRAFT status. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Update PROT (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Gasing Aceh\",\n  \"statusAsalUsul\": \"Permainan tradisional khas Aceh\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/prot/:id",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Partially update a PROT (only DRAFT or REVISI status). Kurator can only edit own PROT. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Update PROT (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Gasing Aceh\",\n  \"jenis\": \"PERMAINAN_RAKYAT\",\n  \"targetUsia\": \"ANAK\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/prot/:id",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Fully update a PROT (only DRAFT or REVISI status). Kurator can only edit own PROT. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Submit for Verification (Kurasi)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"catatan\": \"Silakan verifikasi PROT ini\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/prot/:id/submit-kurasi",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id", "submit-kurasi"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Submit PROT for verification. Moves status from DRAFT to DIKURASI and adds to verification queue. Requires role: kurator_daerah"
          },
          "response": []
        },
        {
          "name": "Resubmit After Revision",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prot/:id/resubmit",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id", "resubmit"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Resubmit PROT after completing revisions. Moves status from REVISI to DIKURASI and re-adds to verification queue. Requires role: kurator_daerah"
          },
          "response": []
        },
        {
          "name": "Upload Foto Kegiatan",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Upload up to 10 image files (jpg, png, webp, max 100MB each)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/prot/:id/foto-kegiatan",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id", "foto-kegiatan"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Upload photos for PROT activities. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Upload Video Kegiatan",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Upload up to 10 video files (mp4, mov, max 100MB each)"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/prot/:id/video-kegiatan",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id", "video-kegiatan"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Upload videos for PROT activities. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Delete Foto Kegiatan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prot/:id/foto-kegiatan/:index",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id", "foto-kegiatan", ":index"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                },
                {
                  "key": "index",
                  "value": "0",
                  "description": "Photo index in array (0-based)"
                }
              ]
            },
            "description": "Remove a photo from fotoKegiatan array by index. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Delete Video Kegiatan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prot/:id/video-kegiatan/:index",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id", "video-kegiatan", ":index"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                },
                {
                  "key": "index",
                  "value": "0",
                  "description": "Video index in array (0-based)"
                }
              ]
            },
            "description": "Remove a video from videoKegiatan array by index. Requires role: kurator_daerah or admin_kpoti"
          },
          "response": []
        }
      ],
      "description": "Endpoints for Kurator Daerah and Admin KPOTI roles"
    },
    {
      "name": "Verifikasi - Pakar",
      "item": [
        {
          "name": "Get Available Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/verifikasi/queue?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", "queue"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get PROT available for verification (not yet assigned). Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Get My Queue (Assigned)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/verifikasi/my-queue?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", "my-queue"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Get PROT assigned to the current pakar. Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Pick PROT from Queue",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/verifikasi/queue/:queueId/pick",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", "queue", ":queueId", "pick"],
              "variable": [
                {
                  "key": "queueId",
                  "value": "{{queueId}}",
                  "description": "Queue ID (UUID)"
                }
              ]
            },
            "description": "Assign a PROT from queue to yourself. Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Release Assigned PROT",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/verifikasi/queue/:queueId/release",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", "queue", ":queueId", "release"],
              "variable": [
                {
                  "key": "queueId",
                  "value": "{{queueId}}",
                  "description": "Queue ID (UUID)"
                }
              ]
            },
            "description": "Release an assigned PROT back to the queue. Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Submit Review - APPROVED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"catatan\": \"Dokumentasi lengkap dan akurat\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/verifikasi/:protId/review",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", ":protId", "review"],
              "variable": [
                {
                  "key": "protId",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Submit APPROVED review. Moves PROT to DIVERIFIKASI status. Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Submit Review - REVISION_NEEDED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REVISION_NEEDED\",\n  \"catatan\": \"Perlu dilengkapi\",\n  \"saran_perbaikan\": \"Tambahkan referensi sejarah dan aturan permainan yang lebih detail\",\n  \"dokumen_pendukung\": [\"https://example.com/reference.pdf\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/verifikasi/:protId/review",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", ":protId", "review"],
              "variable": [
                {
                  "key": "protId",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Submit REVISION_NEEDED review. Moves PROT to REVISI status. Requires saran_perbaikan. Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Submit Review - REJECTED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"catatan\": \"Data tidak valid atau tidak sesuai kriteria\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/verifikasi/:protId/review",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", ":protId", "review"],
              "variable": [
                {
                  "key": "protId",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Submit REJECTED review. Moves PROT back to DRAFT status. Requires role: pakar"
          },
          "response": []
        },
        {
          "name": "Get Verification History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/verifikasi/:protId/history",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", ":protId", "history"],
              "variable": [
                {
                  "key": "protId",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Get all verification history for a PROT. Requires role: pakar, admin_kpoti, or kurator_daerah"
          },
          "response": []
        }
      ],
      "description": "Endpoints for Pakar role - verification workflow"
    },
    {
      "name": "Verifikasi - Admin",
      "item": [
        {
          "name": "Publish to National Archive",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"catatan\": \"Dipublikasikan ke arsip nasional\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/verifikasi/prot/:protId/publish",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", "prot", ":protId", "publish"],
              "variable": [
                {
                  "key": "protId",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Publish PROT to national archive. Moves status from DIVERIFIKASI to ARSIP_NASIONAL. Requires role: admin_kpoti"
          },
          "response": []
        },
        {
          "name": "Get Verification Statistics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/verifikasi/stats",
              "host": ["{{base_url}}"],
              "path": ["verifikasi", "stats"]
            },
            "description": "Get verification statistics including queue counts, approval counts, and PROT counts by status. Requires role: admin_kpoti"
          },
          "response": []
        }
      ],
      "description": "Admin-only verification endpoints"
    },
    {
      "name": "PROT - Admin KPOTI Only",
      "item": [
        {
          "name": "Delete PROT",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prot/:id",
              "host": ["{{base_url}}"],
              "path": ["prot", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "{{protId}}",
                  "description": "PROT ID (UUID)"
                }
              ]
            },
            "description": "Delete a PROT. Requires role: admin_kpoti only"
          },
          "response": []
        }
      ],
      "description": "Endpoints exclusive to Admin KPOTI role"
    }
  ]
}
